---
import type { Project } from '../data/site';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class:list={['card', { featured: project.featured }]}>
  <h3>
    {project.page ? <a href={project.page}>{project.name}</a> : project.name}
  </h3>
  <p>{project.summary}</p>
  <ul class="tags">
    {project.tags.map((t) => <li>{t}</li>)}
  </ul>
  {
    (project.page || project.repo || project.demo) && (
      <div class="card-links">
        {project.page && <a href={project.page}>Case study →</a>}
        {project.demo && <a href={project.demo}>Live demo ↗</a>}
        {project.repo && <a href={project.repo}>Source ↗</a>}
      </div>
    )
  }
</article>
