---
import Layout from './Layout.astro';
import { profile } from '../data/site';

interface Props {
  title: string;
  kicker: string;
  lead: string;
  meta: { label: string; value: string }[];
  links?: { label: string; href: string; primary?: boolean }[];
}
const { title, kicker, lead, meta, links = [] } = Astro.props;
---

<Layout title={`${title} · ${profile.name}`} description={lead}>
  <article class="cs">
    <header class="cs-hero container">
      <a class="back" href="/#projects">← All projects</a>
      <p class="eyebrow">{kicker}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      {
        links.length > 0 && (
          <div class="actions">
            {links.map((l) => (
              <a class:list={['btn', { primary: l.primary }]} href={l.href}>
                {l.label}
              </a>
            ))}
          </div>
        )
      }
      <dl class="cs-meta">
        {
          meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>
    <slot />
  </article>
</Layout>
