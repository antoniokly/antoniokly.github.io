---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, skills, projects } from '../data/site';

const { links } = profile;
const contacts = [
  links.email && { label: 'Email', href: `mailto:${links.email}` },
  links.github && { label: 'GitHub', href: links.github },
  links.linkedin && { label: 'LinkedIn', href: links.linkedin },
  links.resume && { label: 'Résumé', href: links.resume },
].filter(Boolean) as { label: string; href: string }[];
---

<Layout>
  <section class="hero container">
    <p class="eyebrow">{profile.role}{profile.location && ` · ${profile.location}`}</p>
    <h1>Hi, I'm {profile.name.split(' ')[0]}.</h1>
    <p class="lead">{profile.tagline}</p>
    <div class="actions">
      <a class="btn primary" href="#projects">See my work</a>
      {links.resume && <a class="btn" href={links.resume}>Download résumé</a>}
      {!links.resume && links.github && <a class="btn" href={links.github}>GitHub</a>}
    </div>
  </section>

  <section id="about" class="container section">
    <h2>About</h2>
    <div class="about">
      <div>{profile.about.map((p) => <p>{p}</p>)}</div>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="projects" class="container section">
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="contact" class="container section contact">
    <h2>Get in touch</h2>
    <p>I'm open to new roles and interesting projects.</p>
    <ul class="contact-links">
      {contacts.map((c) => <li><a class="btn" href={c.href}>{c.label}</a></li>)}
    </ul>
  </section>
</Layout>
