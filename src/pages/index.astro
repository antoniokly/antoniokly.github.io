---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, motivation, strengths, skills, projects, shippedApps } from '../data/site';

const { links } = profile;
const contacts = [
  links.email && { label: 'Email', href: `mailto:${links.email}` },
  links.linkedin && { label: 'LinkedIn', href: links.linkedin },
  links.github && { label: 'GitHub', href: links.github },
  links.resume && { label: 'Résumé', href: links.resume },
].filter(Boolean) as { label: string; href: string }[];
---

<Layout>
  <section class="hero container">
    <p class="eyebrow">{profile.role}{profile.location && ` · ${profile.location}`}</p>
    <h1>AI that's trusted with<br />real numbers.</h1>
    <p class="lead">
      {profile.tagline}
    </p>
    <div class="actions">
      <a class="btn primary" href="/projects/chatfinance/">Read the ChatFinance case study</a>
      <a class="btn" href="https://chatfinance.duckdns.org">Try the live demo ↗</a>
    </div>
  </section>

  <section class="container section">
    <div class="feature">
      <a class="feature-media" href="/projects/chatfinance/">
        <img
          src="/images/chatfinance/live-confirm.jpg"
          alt="ChatFinance asking the user to confirm a car loan before saving it"
          width="1360"
          height="728"
        />
      </a>
      <div class="feature-body">
        <p class="eyebrow">Featured · ChatFinance</p>
        <h2>An agent that asks before it writes</h2>
        <p>
          Describe a loan, a salary or a property purchase in plain English. A LangGraph agent extracts the
          details, asks for anything missing, rejects numbers you never said, and shows exactly what it will
          save. Tested code does every calculation.
        </p>
        <ul class="tags">
          <li>Python</li><li>LangGraph</li><li>FastAPI</li><li>React</li><li>Evals</li><li>Langfuse</li>
        </ul>
        <a href="/projects/chatfinance/">Read the case study →</a>
      </div>
    </div>
  </section>

  <section id="why" class="container section">
    <div class="why">
      <div class="why-story">
        <p class="eyebrow">My motivation</p>
        <h2>{motivation.heading}</h2>
        {motivation.paragraphs.map((p) => <p>{p}</p>)}
        <p class="pull">{motivation.pull}</p>
      </div>
      <aside class="why-goals">
        <h3>What I'm aiming for</h3>
        <ol class="objectives">
          {
            motivation.goals.map((g) => (
              <li>
                <strong>{g.title}</strong>
                <span>{g.body}</span>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </section>

  <section id="about" class="container section">
    <h2>About</h2>
    <div class="about">
      <div>{profile.about.map((p) => <p>{p}</p>)}</div>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="container section">
    <h2>What I bring</h2>
    <div class="strength-grid">
      {
        strengths.map((s) => (
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="projects" class="container section">
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="apps" class="container section">
    <h2>A decade of production apps</h2>
    <p class="section-intro">Before AI engineering, I spent more than ten years shipping apps people rely on every day, in banking, energy and consumer products.</p>
    <div class="apps">
      {
        shippedApps.map((a) => (
          <article class="app">
            <div class="app-head">
              <h3>{a.link ? <a href={a.link}>{a.name} ↗</a> : a.name}</h3>
              <span class="app-when">{a.when}</span>
            </div>
            <p class="app-company">{a.company}</p>
            <p>{a.what}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="contact" class="container section contact">
    <h2>Get in touch</h2>
    <p>I'm looking for AI engineering roles where agents meet real business data.</p>
    <ul class="contact-links">
      {contacts.map((c) => <li><a class="btn" href={c.href}>{c.label}</a></li>)}
    </ul>
  </section>
</Layout>
